# margin only reads this file if you name it: set MARGIN_ENV_FILE to its path. A .env in the
# current folder is ignored, because that folder may be a repository you are analysing.
#
# Model settings can also be changed in the web UI (Settings). What you save there is kept
# in your user folder (Windows: %APPDATA%\margin\settings.json, macOS: ~/Library/Application
# Support/margin, Linux: ~/.config/margin) and overrides this file. Environment variables you
# set yourself override both. Empty values here are ignored.

# Local LLM (default): any OpenAI-compatible server.
# Ollama http://localhost:11434 | LM Studio http://localhost:1234
# llama.cpp http://localhost:8080 | vLLM http://localhost:8000
LOCAL_LLM_BASE_URL=http://localhost:11434
# Only for servers started with an API key (e.g. vLLM --api-key)
LOCAL_LLM_API_KEY=

# Hosted LLM API keys (optional; only needed with DEFAULT_LLM_PROVIDER=anthropic|openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub Access (Optional for public repos, recommended for higher rate limits or private repos)
GITHUB_TOKEN=

# Global Defaults
# local | anthropic | openai | mock
DEFAULT_LLM_PROVIDER=local
# The model per provider. Empty = the provider's default (local: qwen3.5:9b).
LOCAL_LLM_MODEL=
ANTHROPIC_MODEL=
OPENAI_MODEL=
# Older shared setting; applies only to DEFAULT_LLM_PROVIDER, after the per-provider one.
DEFAULT_LLM_MODEL=
MAX_COST_USD=1.00
LOG_LEVEL=INFO
# Thinking models (e.g. qwen3.5) reason before answering unless this is "none". Empty: omit.
LOCAL_LLM_REASONING_EFFORT=none
