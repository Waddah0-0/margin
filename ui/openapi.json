            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status",
          "queue_position",
          "links"
        ],
        "title": "RunCreated",
        "type": "object"
      },
      "RunMetadata": {
        "additionalProperties": false,
        "description": "Execution metadata attached to every result.",
        "properties": {
          "answers": {
            "description": "Questions the agent asked, and how each was answered.",
