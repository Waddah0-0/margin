{
  "components": {
    "schemas": {
      "AgentInfo": {
        "additionalProperties": false,
        "description": "Static description of an agent, including its JSON schemas.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "output_schema": {
            "additionalProperties": true,
            "title": "Output Schema",
            "type": "object"
          },
          "primary_input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Input field filled by a positional CLI argument.",
            "title": "Primary Input"
          },
          "uses_llm": {
            "default": false,
            "description": "Whether runs normally call a model.",
            "title": "Uses Llm",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "version",
          "input_schema",
          "output_schema"
        ],
        "title": "AgentInfo",
        "type": "object"
      },
      "AgentList": {
        "properties": {
          "agents": {
            "items": {
              "$ref": "#/components/schemas/AgentInfo"
            },
            "title": "Agents",
            "type": "array"
          },
          "load_errors": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Installed agents that failed to load, and why.",
            "title": "Load Errors",
            "type": "object"
          }
        },
        "required": [
          "agents"
        ],
        "title": "AgentList",
        "type": "object"
      },
      "AgentResult": {
        "additionalProperties": false,
        "description": "The standard result returned by every agent.\n\n``status`` semantics:\n\n- ``ok``: everything requested was done. ``error`` is null.\n- ``partial``: a usable result, but some requested work was skipped (a budget or time cap\n  was hit, some files were unreadable, an optional step was unavailable). Each skipped\n  part has an entry in ``warnings``. ``data`` is complete in shape but may hold fewer\n  items. ``error`` is null.\n- ``error``: no usable result. ``data`` is empty and ``error`` holds the message.",
        "properties": {
          "agent_id": {
            "title": "Agent Id",
            "type": "string"
          },
          "agent_version": {
            "title": "Agent Version",
            "type": "string"
          },
          "data": {
            "additionalProperties": true,
            "description": "Agent-specific payload, validated by its OutputModel.",
            "title": "Data",
            "type": "object"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Error message when status is 'error'.",
            "title": "Error"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "metadata": {
            "$ref": "#/components/schemas/RunMetadata"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "description": "2-3 sentence human summary.",
            "title": "Summary",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "agent_id",
          "agent_version",
          "status",
          "summary"
        ],
        "title": "AgentResult",
        "type": "object"
      },
      "Answer": {
        "additionalProperties": false,
        "description": "How one question was answered, kept with the result so every choice can be traced.\n\n``source`` says who decided: ``user`` (answered when asked), ``preset`` (given with the\nrun's input) or ``default`` (the question's default was assumed; nobody confirmed it).",
        "properties": {
          "label": {
            "description": "The answer in readable form.",
            "title": "Label",
            "type": "string"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "question_id": {
            "title": "Question Id",
            "type": "string"
          },
          "source": {
            "enum": [
              "user",
              "preset",
              "default"
            ],
            "title": "Source",
            "type": "string"
          },
          "value": {
            "title": "Value"
          }
        },
        "required": [
          "question_id",
          "prompt",
          "label",
          "source"
        ],
        "title": "Answer",
        "type": "object"
      },
      "AnswersBody": {
        "additionalProperties": false,
        "properties": {
          "answers": {
            "additionalProperties": true,
            "description": "Answers by question id. A question left out takes its default.",
            "title": "Answers",
            "type": "object"
          },
          "batch": {
            "description": "The id of the questions being answered (`question.id`).",
            "title": "Batch",
            "type": "string"
          }
        },
        "required": [
          "batch"
        ],
        "title": "AnswersBody",
        "type": "object"
      },
      "Choice": {
        "additionalProperties": false,
        "description": "One option of a :class:`Question`.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A short explanation of the option.",
            "title": "Detail"
          },
          "label": {
            "description": "What the person sees.",
            "title": "Label",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ],
            "description": "What the agent gets when this is picked.",
            "title": "Value"
          }
        },
        "required": [
          "value",
          "label"
        ],
        "title": "Choice",
        "type": "object"
      },
      "ConnectionRequest": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider": {
            "anyOf": [
              {
                "enum": [
                  "local",
                  "anthropic",
                  "openai"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          }
        },
        "title": "ConnectionRequest",
        "type": "object"
      },
      "ConnectionResult": {
        "properties": {
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "provider",
          "model",
          "latency_ms",
          "message"
        ],
        "title": "ConnectionResult",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "description": "A single, checkable piece of evidence supporting a finding.",
        "properties": {
          "detail": {
            "description": "Human-readable explanation.",
            "title": "Detail",
            "type": "string"
          },
          "kind": {
            "description": "Evidence type, e.g. \"file\", \"commit\", \"config\", \"metric\".",
            "title": "Kind",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where to look, e.g. \"src/utils.py:10-42\" or a commit SHA.",
            "title": "Location"
          },
          "weight": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Contribution to the score, if applicable.",
            "title": "Weight"
          }
        },
        "required": [
          "kind",
          "detail"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Finding": {
        "additionalProperties": false,
        "description": "A titled conclusion backed by evidence.",
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "severity_or_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity Or Score"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "summary"
        ],
        "title": "Finding",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LLMSettingsUpdate": {
        "additionalProperties": false,
        "description": "Only the fields present change. For models and keys, an empty string removes the\nsaved value (the next source in line applies again).",
        "properties": {
          "keys": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "propertyNames": {
                  "enum": [
                    "local",
                    "anthropic",
                    "openai"
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Keys"
          },
          "local_base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Base Url"
          },
          "max_cost_usd": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Cost Usd"
          },
          "models": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "propertyNames": {
                  "enum": [
                    "local",
                    "anthropic",
                    "openai"
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Models"
          },
          "provider": {
            "anyOf": [
              {
                "enum": [
                  "local",
                  "anthropic",
                  "openai"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          }
        },
        "title": "LLMSettingsUpdate",
        "type": "object"
      },
      "LLMSettingsView": {
        "properties": {
          "local_base_url": {
            "title": "Local Base Url",
            "type": "string"
          },
          "local_base_url_source": {
            "enum": [
              "environment",
              "saved",
              "env_file",
              "default"
            ],
            "title": "Local Base Url Source",
            "type": "string"
          },
          "max_cost_usd": {
            "description": "Spending cap per run, for hosted providers.",
            "title": "Max Cost Usd",
            "type": "number"
          },
          "provider": {
            "enum": [
              "local",
              "anthropic",
              "openai"
            ],
            "title": "Provider",
            "type": "string"
          },
          "provider_source": {
            "enum": [
              "environment",
              "saved",
              "env_file",
              "default"
            ],
            "title": "Provider Source",
            "type": "string"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderView"
            },
            "title": "Providers",
            "type": "array"
          },
          "saving_enabled": {
            "title": "Saving Enabled",
            "type": "boolean"
          },
          "settings_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Settings File"
          }
        },
        "required": [
          "provider",
          "provider_source",
          "local_base_url",
          "local_base_url_source",
          "max_cost_usd",
          "providers",
          "saving_enabled",
          "settings_file"
        ],
        "title": "LLMSettingsView",
        "type": "object"
      },
      "ModelList": {
        "properties": {
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          },
          "provider": {
            "enum": [
              "local",
              "anthropic",
              "openai"
            ],
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "models"
        ],
        "title": "ModelList",
        "type": "object"
      },
      "ProgressEvent": {
        "additionalProperties": false,
        "description": "A progress update emitted during a run (consumed by CLI/UI).",
        "properties": {
          "fraction": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fraction"
          },
          "message": {
            "default": "",
            "title": "Message",
            "type": "string"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "stage"
        ],
        "title": "ProgressEvent",
        "type": "object"
      },
      "ProviderView": {
        "properties": {
          "default_model": {
            "title": "Default Model",
            "type": "string"
          },
          "id": {
            "enum": [
              "local",
              "anthropic",
              "openai"
            ],
            "title": "Id",
            "type": "string"
          },
          "key_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Last four characters of the key, never the key.",
            "title": "Key Hint"
          },
          "key_set": {
            "title": "Key Set",
            "type": "boolean"
          },
          "key_source": {
            "enum": [
              "environment",
              "saved",
              "env_file",
              "default"
            ],
            "title": "Key Source",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "model": {
            "description": "The model runs use with this provider.",
            "title": "Model",
            "type": "string"
          },
          "model_source": {
            "enum": [
              "environment",
              "saved",
              "env_file",
              "default"
            ],
            "title": "Model Source",
            "type": "string"
          },
          "needs_key": {
            "title": "Needs Key",
            "type": "boolean"
          },
          "on_device": {
            "description": "False: prompts, such as samples of code, leave this machine.",
            "title": "On Device",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "needs_key",
          "on_device",
          "default_model",
          "model",
          "model_source",
          "key_set",
          "key_hint",
          "key_source"
        ],
        "title": "ProviderView",
        "type": "object"
      },
      "Question": {
        "additionalProperties": false,
        "description": "Something an agent asks the person running it, with the evidence behind the question.\n\n``choice`` takes one of ``choices`` (or any text, with ``allow_other``), ``multi_choice``\ntakes a list of them, and ``text`` takes free text.",
        "properties": {
          "allow_other": {
            "default": false,
            "description": "choice only: any text is accepted besides the choices.",
            "title": "Allow Other",
            "type": "boolean"
          },
          "choices": {
            "items": {
              "$ref": "#/components/schemas/Choice"
            },
            "title": "Choices",
            "type": "array"
          },
          "default": {
            "description": "Used when the question is not asked; the suggested answer.",
            "title": "Default"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the agent is asking.",
            "title": "Detail"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "description": "Stable key, e.g. \"date_format:order_date\".",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "default": "choice",
            "enum": [
              "choice",
              "multi_choice",
              "text"
            ],
            "title": "Kind",
            "type": "string"
          },
          "prompt": {
            "description": "The question, as one sentence.",
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "required": {
            "default": true,
            "description": "Whether an empty answer is refused.",
            "title": "Required",
            "type": "boolean"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A heading to group questions under.",
            "title": "Section"
          }
        },
        "required": [
          "id",
          "prompt"
        ],
        "title": "Question",
        "type": "object"
      },
      "QuestionBatch": {
        "additionalProperties": false,
        "description": "Questions asked together, at one point of a run.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "minItems": 1,
            "title": "Questions",
            "type": "array"
          },
          "title": {
            "description": "What is being decided, e.g. \"Check the plan\".",
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "questions"
        ],
        "title": "QuestionBatch",
        "type": "object"
      },
      "RunCreated": {
        "properties": {
          "links": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Links",
            "type": "object"
          },
          "queue_position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue Position"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
